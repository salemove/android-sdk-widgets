        <item name="chatStartedHeadingTextColor">?attr/gliaChatStartedHeadingTextColor</item>
        <item name="chatStartedCaptionTextColor">?attr/gliaChatStartedCaptionTextColor</item>
        <item name="iconCallVisualizerTintColor">?attr/gliaIconCallVisualizerTintColor</item>
        <item name="visitorMessageBackgroundColor">?attr/gliaVisitorMessageBackgroundColor</item>
