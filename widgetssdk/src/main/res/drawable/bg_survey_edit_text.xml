<?xml version="1.0" encoding="utf-8"?>
<!--
    Free-text survey answer field background.

    `InputQuestionViewHolder` used to replace this drawable's colours at bind time and on every focus
    change from `InputQuestionConfiguration`; the fill and the stateful stroke live here instead, so
    the field renders normal / focused / error itself. `state_activated` carries the error - the view
    holder sets `isActivated` from the validation state.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/glia_survey_default_corner_radius" />
    <solid android:color="?attr/gliaBaseLightColor" />
    <stroke
        android:width="@dimen/glia_survey_default_border_width"
        android:color="@color/survey_input_field_stroke_color_states" />
</shape>
