<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base theme of every Glia surface.

        It carries the Material chain plus default values for *all* `glia*` global attributes and
        for every non-`glia*` infrastructure attribute the SDK reads. Layouts resolve those values
        natively via `?attr/glia*`, so they must live in the real `Resources.Theme` of each
        inflation context - which is why this is a full theme and not a `materialThemeOverlay`.

        Composition order (see `helper/GliaThemeOverlays.kt`):
        Theme.Glia.Internal -> legacy `gliaChatStyle` -> `materialThemeOverlay` -> GliaTheme -> JSON.
    -->
    <style name="Theme.Glia.Internal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="gliaBrandPrimaryColor">@color/glia_primary_color</item>
        <item name="gliaBaseDarkColor">@color/glia_dark_color</item>
        <item name="gliaBaseLightColor">@color/glia_light_color</item>
        <item name="gliaBaseNormalColor">@color/glia_normal_color</item>
        <item name="gliaBaseShadeColor">@color/glia_shade_color</item>
        <item name="gliaSystemNegativeColor">@color/glia_negative_color</item>
        <item name="gliaSystemAgentBubbleColor">@color/glia_neutral_color</item>
        <item name="gliaChatBackgroundColor">@color/glia_chat_background_color</item>
        <item name="gliaIconCallVisualizerTintColor">@color/glia_light_color</item>
        <item name="gliaIconAppBarBack">@drawable/ic_baseline_arrow_back</item>
        <item name="gliaIconLeaveQueue">@drawable/ic_baseline_close</item>
        <item name="gliaIconSendMessage">@drawable/ic_baseline_send</item>
        <item name="gliaIconChatAudioUpgrade">@drawable/ic_baseline_mic</item>
        <item name="gliaIconUpgradeAudioDialog">@drawable/ic_baseline_mic</item>
        <item name="gliaIconCallAudioOn">@drawable/ic_baseline_mic</item>
        <item name="gliaIconChatVideoUpgrade">@drawable/ic_baseline_videocam</item>
        <item name="gliaIconUpgradeVideoDialog">@drawable/ic_baseline_videocam</item>
        <item name="gliaIconCallVideoOn">@drawable/ic_baseline_videocam</item>
        <item name="gliaIconCallAudioOff">@drawable/ic_baseline_mic_off</item>
        <item name="gliaIconCallVideoOff">@drawable/ic_baseline_videocam_off</item>
        <item name="gliaIconCallChat">@drawable/ic_chat_cloud</item>
        <item name="gliaIconCallSpeakerOn">@drawable/ic_baseline_volume_up</item>
        <item name="gliaIconCallSpeakerOff">@drawable/ic_baseline_volume_off</item>
        <item name="gliaIconCallMinimize">@drawable/ic_minimize</item>
        <item name="gliaIconPlaceholder">@drawable/ic_person</item>
        <item name="gliaIconOnHold">@drawable/ic_pause_circle</item>

        <item name="gliaSendMessageButtonTintColor">?attr/gliaBrandPrimaryColor</item>

        <item name="gliaChatHeaderTitleTintColor">?attr/gliaBaseLightColor</item>
        <item name="gliaChatHeaderHomeButtonTintColor">?attr/gliaBaseLightColor</item>
        <item name="gliaChatHeaderExitQueueButtonTintColor">?attr/gliaBaseLightColor</item>

