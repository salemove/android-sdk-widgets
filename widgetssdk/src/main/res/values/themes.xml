<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base theme of every Glia surface.

        It carries the Material chain plus default values for *all* `glia*` global attributes and
        for every non-`glia*` infrastructure attribute the SDK reads. Layouts resolve those values
        natively via `?attr/glia*`, so they must live in the real `Resources.Theme` of each
        inflation context - which is why this is a full theme and not a `materialThemeOverlay`.

        Composition order (see `helper/GliaThemeOverlays.kt`):
        Theme.Glia.Internal -> legacy `gliaChatStyle` -> `materialThemeOverlay` -> GliaTheme -> JSON.
    -->
    <style name="Theme.Glia.Internal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="gliaBrandPrimaryColor">@color/glia_primary_color</item>
        <item name="gliaBaseDarkColor">@color/glia_dark_color</item>
        <item name="gliaBaseLightColor">@color/glia_light_color</item>
        <item name="gliaBaseNormalColor">@color/glia_normal_color</item>
        <item name="gliaBaseShadeColor">@color/glia_shade_color</item>
        <item name="gliaSystemNegativeColor">@color/glia_negative_color</item>
        <item name="gliaSystemAgentBubbleColor">@color/glia_neutral_color</item>
        <item name="gliaChatBackgroundColor">@color/glia_chat_background_color</item>
        <item name="gliaIconCallVisualizerTintColor">@color/glia_light_color</item>
        <item name="gliaIconAppBarBack">@drawable/ic_baseline_arrow_back</item>
        <item name="gliaIconLeaveQueue">@drawable/ic_baseline_close</item>
        <item name="gliaIconSendMessage">@drawable/ic_baseline_send</item>
        <item name="gliaIconChatAudioUpgrade">@drawable/ic_baseline_mic</item>
        <item name="gliaIconUpgradeAudioDialog">@drawable/ic_baseline_mic</item>
        <item name="gliaIconCallAudioOn">@drawable/ic_baseline_mic</item>
        <item name="gliaIconChatVideoUpgrade">@drawable/ic_baseline_videocam</item>
        <item name="gliaIconUpgradeVideoDialog">@drawable/ic_baseline_videocam</item>
        <item name="gliaIconCallVideoOn">@drawable/ic_baseline_videocam</item>
        <item name="gliaIconCallAudioOff">@drawable/ic_baseline_mic_off</item>
        <item name="gliaIconCallVideoOff">@drawable/ic_baseline_videocam_off</item>
        <item name="gliaIconCallChat">@drawable/ic_chat_cloud</item>
        <item name="gliaIconCallSpeakerOn">@drawable/ic_baseline_volume_up</item>
        <item name="gliaIconCallSpeakerOff">@drawable/ic_baseline_volume_off</item>
        <item name="gliaIconCallMinimize">@drawable/ic_minimize</item>
        <item name="gliaIconPlaceholder">@drawable/ic_person</item>
        <item name="gliaIconOnHold">@drawable/ic_pause_circle</item>

        <item name="gliaSendMessageButtonTintColor">?attr/gliaBrandPrimaryColor</item>

        <item name="gliaChatHeaderTitleTintColor">?attr/gliaBaseLightColor</item>
        <item name="gliaChatHeaderHomeButtonTintColor">?attr/gliaBaseLightColor</item>
        <item name="gliaChatHeaderExitQueueButtonTintColor">?attr/gliaBaseLightColor</item>

        <item name="gliaChatStartingHeadingTextColor">?attr/gliaBaseDarkColor</item>
        <item name="gliaChatStartingCaptionTextColor">?attr/gliaBaseNormalColor</item>
        <item name="gliaChatStartedHeadingTextColor">?attr/gliaBaseDarkColor</item>
        <item name="gliaChatStartedCaptionTextColor">?attr/gliaBrandPrimaryColor</item>

        <item name="gliaVisitorMessageBackgroundColor">?attr/gliaBrandPrimaryColor</item>
        <item name="gliaVisitorMessageTextColor">?attr/gliaBaseLightColor</item>
        <item name="gliaOperatorMessageBackgroundColor">?attr/gliaSystemAgentBubbleColor</item>
        <item name="gliaOperatorMessageTextColor">?attr/gliaBaseDarkColor</item>
        <item name="gliaNewMessagesDividerColor">?attr/gliaBrandPrimaryColor</item>
        <item name="gliaNewMessagesDividerTextColor">?attr/gliaBrandPrimaryColor</item>
        <item name="gliaBotActionButtonBackgroundColor">?attr/gliaSystemAgentBubbleColor</item>
        <item name="gliaBotActionButtonTextColor">?attr/gliaBaseDarkColor</item>

        <!--        GVA-->
        <item name="gvaOptionButtonStyle">@style/Application.Glia.Chat.Button.Gva</item>
        <item name="gvaQuickReplyButtonStyle">@style/Application.Glia.Chat.GvaChip</item>
        <item name="gvaQuickReplyBackgroundColor">@android:color/transparent</item>
        <item name="gvaQuickReplyStrokeColor">?attr/gliaBrandPrimaryColor</item>
        <item name="gvaQuickReplyTextColor">?attr/gliaBrandPrimaryColor</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Glia.Chat.AlertDialog</item>
        <item name="toolbarStyle">@style/Widget.MaterialComponents.Toolbar.Primary</item>
        <item name="textAppearanceHeadline1">@style/Application.Glia.Header1</item>
        <item name="textAppearanceHeadline2">@style/Application.Glia.Header2</item>
        <item name="textAppearanceHeadline3">@style/Application.Glia.Header3</item>
        <item name="textAppearanceCaption">@style/Application.Glia.Caption</item>
        <item name="textAppearanceBody1">@style/Application.Glia.Body</item>
        <item name="textAppearanceSubtitle2">@style/Application.Glia.Subtitle2</item>

        <item name="gliaHeaderEndButtonStyle">@style/Application.Glia.Header.EndButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Application.Glia.Chat.Button.Positive
        </item>
        <item name="buttonBarNegativeButtonStyle">@style/Application.Glia.Chat.Button.Negative
        </item>
        <item name="buttonBarNeutralButtonStyle">@style/Application.Glia.Chat.Button.Neutral</item>
        <item name="buttonSurveyOptionButtonStyle">@style/Application.Glia.Chat.Button.SurveyOption
        </item>

        <item name="chatHeadStyle">@style/Application.Glia.Chat.ChatHead</item>
        <item name="choiceCardContentTextStyle">@style/Application.Glia.ChoiceCard.ContentText</item>

        <item name="gliaAlertDialogButtonUseVerticalAlignment">false</item>
        <item name="whiteLabel">false</item>

        <item name="chipStyle">?attr/gvaQuickReplyButtonStyle</item>

        <!--
            Opt every Glia surface out of the platform's automatic dark conversion (API 29+).
            The SDK ships no `values-night` colours, so it cannot render a designed dark theme;
            machine-inverting it produces a worse result than staying light, and doing so per-screen
            produced a visibly inconsistent flow. Declared once here so every surface inherits it -
            it cannot live in `values-v29` because a qualified override replaces a style wholesale,
            which would drop every item above.
        -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!--
        The `Theme.Glia.Internal.*` styles rely on implicit parenting: a dotted style name inherits
        the style it is prefixed by, so `parent` would only restate `Theme.Glia.Internal`. Do not
        copy this to the `Application.Glia.*.Activity` aliases below - their implicit parents are
        different styles (or do not exist), so those `parent` attributes are load-bearing.
    -->

    <!--
        Chat-family surfaces (chat, secure messaging, web browser). Currently carries nothing in any
        bucket - it is kept as the named seam for chat-family-only items, so adding one later does not
        mean re-pointing three manifest entries or duplicating `Theme.Glia.Internal`.
    -->
    <style name="Theme.Glia.Internal.Chat" />

    <style name="Theme.Glia.Internal.Translucent">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Glia.Internal.ImagePreview">
        <item name="android:windowBackground">@color/glia_black_color</item>
        <item name="gliaIconAppBarBack">@drawable/ic_baseline_arrow_back</item>
        <item name="colorPrimary">@color/glia_black_color</item>
        <item name="android:colorPrimary">@color/glia_black_color</item>
    </style>

    <!--
        The call app bar floats over the video surface, so it has to stay dark-with-white-content
        whatever the integrator's brand palette is. `CallView.setAppBarTheme()` used to force exactly
        these six values into the `UiTheme` it handed the app bar, which made `call_view.xml`'s own
        `android:backgroundTint` / `app:lightTint` dead attributes. Applied as a view-level
        `android:theme` on the `AppBarView` instead, so the app bar resolves them the same way every
        other Glia view resolves its colours.

        `gliaBaseLightColor` and `gliaSystemNegativeColor` are pinned to the SDK defaults rather than
        left inherited, because the end-engagement button has to stay legible on the dark bar.
    -->
    <style name="ThemeOverlay.Glia.Internal.CallAppBar" parent="">
        <item name="gliaBrandPrimaryColor">@color/glia_call_view_background_color</item>
        <item name="gliaBaseLightColor">@color/glia_light_color</item>
        <item name="gliaSystemNegativeColor">@color/glia_negative_color</item>
        <item name="gliaChatHeaderTitleTintColor">@android:color/white</item>
        <item name="gliaChatHeaderHomeButtonTintColor">@android:color/white</item>
        <item name="gliaChatHeaderExitQueueButtonTintColor">@android:color/white</item>
    </style>

    <!--
        Public override hook. Ships EMPTY on purpose: every default lives in `Theme.Glia.Internal`,
        so an integrator redefining this style only ever contributes the items they declare.

        Integrators customize the SDK by redefining it in their own `res/values`:

            <style name="GliaTheme">
                <item name="gliaBrandPrimaryColor">@color/brand</item>
                <item name="gliaIconAppBarBack">@drawable/back</item>
            </style>

        The name is intentionally a single segment - there is no dot-implicit parent to get wrong
        and no `parent` attribute to remember. Attribute names are documented in `attrs.xml`.
    -->
    <style name="GliaTheme" />

    <!--
        ==========================================================================================
        DEPRECATED - legacy (pre-`GliaTheme`) resources.

        Every style below is superseded by the `GliaTheme` hook above. They are kept declared so
        integrator resources that reference them keep compiling, and the legacy chain is still read
        and still applied - one layer *below* `GliaTheme`, so an integrator can migrate attribute by
        attribute. Nothing here needs to change for an existing integration to keep working.

        The four `Application.Glia.*.Activity` themes are no longer used by the SDK manifest; the
        other three are blanked. `ThemeOverlay.Glia.Chat` in particular is the parent of every legacy
        integrator overlay, so keeping it empty means such an overlay contributes *only* the items
        the integrator actually set when it is applied with
        `Resources.Theme.applyStyle(style, force = true)`.

        Migration: docs/theming-migration.md.
        ==========================================================================================
    -->

    <!--
        @deprecated Use the `GliaTheme` style instead.

        Legacy `defStyleRes` for Glia views, and the documented parent of every legacy integrator
        `gliaChatStyle` style. Kept declared so those styles still compile, but blanked: it used to
        bridge each un-prefixed `GliaView` attribute to its `?attr/glia*` twin, and both the
        styleable and the `UiTheme` parsing that read it are gone. Every value it carried is now
        resolved from the composed theme directly.
    -->
    <style name="Application.Glia.Chat" parent="" />

    <!--
        @deprecated Use the `GliaTheme` style instead.

        Legacy integrator hook: integrators redefine this resource to declare `gliaChatStyle`. Ships
        blank - `GliaThemeOverlays.resolveLegacyThemeOverlay` reads `gliaChatStyle` out of it, and
        still applies whatever it finds.
    -->
    <style name="Application.Glia.Activity.Style" parent="Theme.MaterialComponents.DayNight.NoActionBar" />

    <!--
        @deprecated Superseded by `Theme.Glia.Internal.Chat`, which the manifest now declares. Kept
        for compile compatibility; customize with `GliaTheme` rather than by overriding this.
    -->
    <style name="Application.Glia.Chat.Activity" parent="Theme.Glia.Internal.Chat" />

    <!--
        @deprecated Superseded by `Theme.Glia.Internal`, which the manifest now declares. Kept for
        compile compatibility; customize with `GliaTheme` rather than by overriding this.
    -->
    <style name="Application.Glia.Call.Activity" parent="Theme.Glia.Internal" />

    <!--
        @deprecated Superseded by `Theme.Glia.Internal.ImagePreview`, which the manifest now
        declares. Kept for compile compatibility; customize with `GliaTheme` rather than by
        overriding this.
    -->
    <style name="Application.Glia.ImagePreview.Activity" parent="Theme.Glia.Internal.ImagePreview" />

    <!--
        @deprecated Superseded by `Theme.Glia.Internal.Translucent`, which the manifest now declares.
        Kept for compile compatibility; customize with `GliaTheme` rather than by overriding this.
    -->
    <style name="Application.Glia.Translucent.Activity" parent="Theme.Glia.Internal.Translucent" />

    <!--
        @deprecated Use the `GliaTheme` style instead.

        Parent of every legacy integrator `materialThemeOverlay`. Intentionally EMPTY - see the block
        comment above.
    -->
    <style name="ThemeOverlay.Glia.Chat" parent="" />

    <style name="ThemeOverlay.Glia.Chat.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App</item>
        <item name="android:backgroundTint">?attr/gliaBaseLightColor</item>
    </style>

    <style name="ThemeOverlay.Glia.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ThemeOverlay.Glia.BottomSheetModal</item>
    </style>

    <style name="ThemeOverlay.Glia.BottomSheetModal" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>


</resources>
